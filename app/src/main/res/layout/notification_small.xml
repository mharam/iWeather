<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notification_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:id="@+id/location_name"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:text="London"
        android:gravity="bottom"
        android:textSize="16sp"
        android:textStyle="bold"
        style="@style/TextAppearance.Compat.Notification.Title" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:id="@+id/date"
        android:layout_below="@id/location_name"
        android:layout_alignParentStart="true"
        android:text="Mon. JAN 13,"
        android:gravity="top"
        android:textSize="12sp"
        android:textFontWeight="350"
        style="@style/TextAppearance.Compat.Notification.Title" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:id="@+id/clock"
        android:layout_below="@id/location_name"
        android:layout_toEndOf="@id/date"
        android:text="16:38"
        android:gravity="top"
        android:textSize="12sp"
        android:textFontWeight="500"
        android:layout_marginStart="4dp"
        style="@style/TextAppearance.Compat.Notification.Title" />
    <ImageView
        android:layout_width="@dimen/notification_temperature_width"
        android:layout_height="@dimen/notification_weather_type_size"
        android:id="@+id/temperature"
        android:contentDescription="weather_type"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:scaleType="fitEnd" />

</RelativeLayout>